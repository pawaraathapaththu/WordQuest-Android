<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080E1E"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:focusableInTouchMode="true">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WORD CHALLENGE"
            android:textColor="#A78BFA"
            android:textSize="12sp"
            android:letterSpacing="0.18"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guess the Word"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/userNameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome, User!"
            android:textColor="#94A3B8"
            android:textSize="16sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp" />

        <!-- Game Statistics -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="#182238"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TIME"
                    android:textColor="#A78BFA"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/timerTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="#182238"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SCORE"
                    android:textColor="#FBBF24"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/scoreTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Score: 100"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:background="#182238"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ATTEMPTS"
                    android:textColor="#34D399"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/attemptTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Attempts left: 10"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Guess Section -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#131D32"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="What's the secret word?"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Think carefully and enter your guess."
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="18dp" />

            <EditText
                android:id="@+id/guessEditText"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="#243149"
                android:hint="Enter your guess..."
                android:textColor="#FFFFFF"
                android:textColorHint="#94A3B8"
                android:textSize="16sp"
                android:inputType="text"
                android:singleLine="true"
                android:padding="14dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/submitButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="#7C3AED"
                android:text="Submit Guess"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false" />

        </LinearLayout>

        <!-- Hint Section -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NEED A LITTLE HELP?"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/getClueButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="#182238"
            android:text="Get a Hint  (-5 pts)"
            android:textColor="#C4B5FD"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/checkLetterButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="#182238"
            android:text="Check a Letter  (-5 pts)"
            android:textColor="#C4B5FD"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/checkLengthButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="#182238"
            android:text="Check Word Length  (-5 pts)"
            android:textColor="#C4B5FD"
            android:textSize="15sp"
            android:textAllCaps="false" />

        <!-- Leaderboard Section -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#243149"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/submitLeaderboardButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#4338CA"
            android:text="Submit Score to Leaderboard"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/leaderboardMessageTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#34D399"
            android:textSize="14sp"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/exitButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="#351C2C"
            android:text="Exit Game"
            android:textColor="#FB7185"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp" />

    </LinearLayout>

</ScrollView>
